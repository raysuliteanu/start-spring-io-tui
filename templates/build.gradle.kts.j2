plugins {
{% if kotlin %}
	kotlin("jvm") version "{{ kotlin_version }}"
	kotlin("plugin.spring") version "{{ kotlin_version }}"
{% elif groovy %}
	groovy
{% else %}
	java
{% endif %}
{% if war %}
	war
{% endif %}
	id("org.springframework.boot") version "{{ boot_version }}"
	id("io.spring.dependency-management") version "{{ dm_version }}"
{% if kotlin_jpa %}
	kotlin("plugin.jpa") version "{{ kotlin_version }}"
{% endif %}
}

group = {{ group_id | kotlin_str }}
version = {{ version | kotlin_str }}
{% if description %}
description = {{ description | kotlin_str }}
{% endif %}

java {
	toolchain {
		languageVersion = JavaLanguageVersion.of({{ java_version }})
	}
}

repositories {
	mavenCentral()
{% for repo in repositories %}
	maven { url = uri({{ repo.url | kotlin_str }}) }
{% endfor %}
}
{% for bom in boms %}
{% if loop.first %}

{% endif %}
extra["{{ bom.gradle_property }}"] = "{{ bom.version }}"
{% endfor %}

dependencies {
{% for dep in gradle_deps %}
	{{ dep.config }}({{ dep.coord | kotlin_str }})
{% endfor %}
}
{% if boms %}

dependencyManagement {
	imports {
{% for bom in boms %}
		mavenBom("{{ bom.group_id }}:{{ bom.artifact_id }}:${property("{{ bom.gradle_property }}")}")
{% endfor %}
	}
}
{% endif %}
{% if kotlin %}

kotlin {
	compilerOptions {
		freeCompilerArgs.addAll("-Xjsr305=strict")
	}
}
{% endif %}
{% if kotlin_jpa %}

allOpen {
	annotation("jakarta.persistence.Entity")
	annotation("jakarta.persistence.MappedSuperclass")
	annotation("jakarta.persistence.Embeddable")
}
{% endif %}

tasks.withType<Test> {
	useJUnitPlatform()
}
